# Copy to .env.local (or run `vercel env pull .env.local`). Never commit real values.

# Database (Turso / libSQL). Local dev can use a file DB.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Vercel Cron sends `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=

# Nightly pulse email (Resend)
RESEND_API_KEY=
PULSE_FROM_EMAIL=
PULSE_TO_EMAIL=
# Sending stays disabled until explicitly enabled. dryRun=true never sends.
PULSE_EMAIL_ENABLED=false

# Salt for buyer_key = SHA-256(salt + ":" + channel + ":" + buyer ID). Keep secret.
BUYER_KEY_SALT=

# Guards the "Reset demo data" route
DEMO_RESET_SECRET=

# Optional: AI note on the scorecard
ANTHROPIC_API_KEY=

# --- Connectors (src/connectors). All optional: without them, `npm run pull -- --mock`
# --- and POST /api/connectors/pull {"mock": true} use mock data in the real API shapes.
# 1 = the pull route defaults to mock data
CONNECTORS_MOCK=
# Folder with inbox/<source_id>/ and fixtures/<source_id>/ (default ./data)
CONNECTOR_DATA_DIR=

# Amazon Selling Partner API (Reports API). LWA app credentials + seller refresh token.
AMAZON_SP_CLIENT_ID=
AMAZON_SP_CLIENT_SECRET=
AMAZON_SP_REFRESH_TOKEN=
# Optional: default ATVPDKIKX0DER (amazon.com), https://sellingpartnerapi-na.amazon.com,
# GET_V2_SETTLEMENT_REPORT_DATA_FLAT_FILE_V2
AMAZON_SP_MARKETPLACE_ID=
AMAZON_SP_ENDPOINT=
AMAZON_SP_REPORT_TYPE=

# eBay REST APIs (Sell Fulfillment + Finances). OAuth app keys + seller refresh token.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=
# Optional: "sandbox" for the sandbox hosts; marketplace header for Finances (default EBAY_US)
EBAY_ENV=
EBAY_MARKETPLACE_ID=

# EasyPost (Shipments + Reports APIs). A free test key (EZTK...) works for trying it.
EASYPOST_API_KEY=

# Optional: loaded processing labor rate for margin KPIs, cents per hour (default 1800 = $18.00/h)
LABOR_RATE_CENTS_PER_HOUR=

# Optional: origin only, no credentials or path. Uses VERCEL_URL on Vercel.
REPORTS_VIEW_ORIGIN=
