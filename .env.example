# Copy to .env.local (or run `vercel env pull .env.local`). Never commit real values.

# Database (Turso / libSQL). Local dev can use a file DB.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Vercel Cron sends `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=

# Nightly pulse email (Resend)
RESEND_API_KEY=
PULSE_FROM_EMAIL=
PULSE_TO_EMAIL=
# Sending stays disabled until explicitly enabled. dryRun=true never sends.
PULSE_EMAIL_ENABLED=false

# Salt for buyer_key = SHA-256(salt + ":" + channel + ":" + buyer ID). Keep secret.
BUYER_KEY_SALT=

# Guards the "Reset demo data" route
DEMO_RESET_SECRET=

# Optional: AI note on the scorecard
ANTHROPIC_API_KEY=

# Data chat (POST /api/chat, npm run chat, npm run eval:chat). Without a key the route returns 503.
# OPENAI_API_KEY is preferred; OPEN_API_KEY is accepted as a fallback name.
OPENAI_API_KEY=
# Optional model override (default gpt-6.1-sol; e.g. gpt-6-astra for the most capable)
OPENAI_MODEL=
# Optional read-only DB credentials for the chat's run_sql tool (a Turso read-only token).
# Unset = the main TURSO_* client is used (the SQL guard still applies).
CHAT_DATABASE_URL=
CHAT_DATABASE_AUTH_TOKEN=

# --- Connectors (src/connectors). All optional: without them, `npm run pull -- --mock`
# --- and POST /api/connectors/pull {"mock": true} use mock data in the real API shapes.
# 1 = the pull route defaults to mock data
CONNECTORS_MOCK=
# Local dev only: 1 = mock pulls generate data for days with no fixture (default: fixture days only, else nothing)
CONNECTORS_MOCK_GENERATE=
# Folder with inbox/<source_id>/ and fixtures/<source_id>/ (default ./data)
CONNECTOR_DATA_DIR=

# Amazon Selling Partner API (Finances listTransactions JSON by default; Reports API with
# AMAZON_SP_FEED=reports). LWA app credentials + seller refresh token.
AMAZON_SP_CLIENT_ID=
AMAZON_SP_CLIENT_SECRET=
AMAZON_SP_REFRESH_TOKEN=
# Optional: default ATVPDKIKX0DER (amazon.com), https://sellingpartnerapi-na.amazon.com,
# GET_V2_SETTLEMENT_REPORT_DATA_FLAT_FILE_V2; AMAZON_SP_FEED = finances (default) | reports
AMAZON_SP_MARKETPLACE_ID=
AMAZON_SP_ENDPOINT=
AMAZON_SP_FEED=
AMAZON_SP_REPORT_TYPE=

# eBay REST APIs (Sell Fulfillment + Finances). OAuth app keys + seller refresh token.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=
# Optional: "sandbox" for the sandbox hosts; marketplace header for Finances (default EBAY_US)
EBAY_ENV=
EBAY_MARKETPLACE_ID=

# Upright Labs Lister Public API (/reports/order_items). Token: Lister > Settings > Developer.
# Without it, the real pull reads the emailed report from data/inbox/upright/.
UPRIGHT_API_TOKEN=
# Optional: API base (default https://app.uprightlabs.com/api); "date" sends time_start/time_end as YYYY-MM-DD
UPRIGHT_API_BASE=
UPRIGHT_API_TIME_FORMAT=

# EasyPost (Shipments + Reports APIs). A free test key (EZTK...) works for trying it.
EASYPOST_API_KEY=
# Ops connectors (not wired yet; leave empty so the drop folders are used)
PAYROLL_API_CLIENT_ID=
PAYROLL_API_CLIENT_SECRET=
MARKETPLACE_RATINGS_API_KEY=

# Optional: loaded processing labor rate for margin KPIs, cents per hour (default 1800 = $18.00/h)
LABOR_RATE_CENTS_PER_HOUR=

# Raw-file archive (src/archive, slide 40 "Archive"). Every ingested file is kept under
# "Month End/<YYYY>/<MM>/<source_id>/<file>". Set by connecting a PRIVATE Vercel Blob store
# to the project (Storage > Blob): Vercel injects BLOB_READ_WRITE_TOKEN (or BLOB_STORE_ID
# with OIDC). Unset = files go to data/archive/ on local disk (dev only; gitignored).
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
# Optional: local archive folder (default ./data/archive)
ARCHIVE_DIR=

# Optional: origin only, no credentials or path. On Vercel it falls back to
# VERCEL_PROJECT_PRODUCTION_URL, then VERCEL_URL.
REPORTS_VIEW_ORIGIN=

# Optional: secret that signs archive download links (falls back to BUYER_KEY_SALT, then CRON_SECRET)
ARCHIVE_LINK_SECRET=
